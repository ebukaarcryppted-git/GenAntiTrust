# Which GenLayer network the scripts talk to: testnet-bradbury | studionet | localnet
GENLAYER_NETWORK=testnet-bradbury

# Hex private key (0x...) of the account used to sign transactions.
# NEVER commit a real key. Generate one with:
#   python -c "from genlayer_py import generate_private_key; print(generate_private_key().hex())"
# and fund it via the CLI keystore flow described in the README, or export
# the CLI keystore's key with `genlayer account export`.
GENLAYER_PRIVATE_KEY=

# Filled in automatically by scripts/deploy.py after a successful deploy.
CONTRACT_ADDRESS=

# Only used by the frontend build (Next.js requires the NEXT_PUBLIC_ prefix
# to expose a value to the browser).
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_GENLAYER_NETWORK=testnet-bradbury
